# Copy to .env.local (gitignored). Used by scripts/start-dev.sh

# Your active league entry team ID (curTeam= from any ImagineSports URL)
DMB_ENTRY_TEAM_ID=YOUR_ENTRY_TEAM_ID

# Paths to sibling repos (adjust for your machine)
DMB_DB_PATH=/path/to/DiamondMind/data/is_scout.db
DMB_SESSION_PATH=/path/to/DiamondMind/.is_session
DMB_CONFIG_PATH=/path/to/dmb-mcp-server/config/leagues.json
DMB_MCP_SRC=/path/to/dmb-mcp-server/src

# Optional: sibling repo roots for ./scripts/sync-iq-sources.sh
# DIAMONDMIND_ROOT=/path/to/DiamondMind
# NEW_DMO_ROOT=/path/to/New-DMO

# Optional: Foundry agent (offline mode works without this)
# Foundry__ProjectEndpoint=https://your-project.services.ai.azure.com/api/projects/your-project
# Foundry__AgentName=dmb-front-office
